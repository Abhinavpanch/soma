# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/soma?retryWrites=true&w=majority

# Server port (Render sets its own PORT automatically)
PORT=5001

# JWT signing secret — use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Set to "production" in Render/Vercel for secure cookies
NODE_ENV=production
