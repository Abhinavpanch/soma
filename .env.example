# Soma — environment variables
# Real values belong ONLY in the Vercel Environment Variables UI.
# This file is a template — do not fill in real secrets here.

# MongoDB Atlas SRV connection string.
# Get it from Atlas → Databases → Connect → Drivers.
# Example format:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/soma?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/soma?retryWrites=true&w=majority

# Port (local dev only; Vercel serverless ignores this).
PORT=5001

# JWT signing secret — use a long random string, NOT the fallback "Abhi".
# This must match on every deploy target; tokens signed with one value
# will not verify against another.
JWT_SECRET=replace-with-a-long-random-string

# Production mode (so session cookies are secure over HTTPS).
NODE_ENV=production
