# Example environment variables for Soma
# Copy this file locally as .env if you need one for development,
# but NEVER commit a real .env to Git.
#
# On Vercel / Render, paste the REAL values into the platform's
# Environment Variables / Secrets UI — do not put them in code or Git.

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/soma?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/soma?retryWrites=true&w=majority

# Server port (Render sets its own PORT automatically; Vercel ignores this)
PORT=5001

# JWT signing secret — MUST be a long random string in production.
# Locally you can use any string; on your host, set a real secret here.
JWT_SECRET=replace-with-a-long-random-string

# Set to "production" when running on a host (enables secure cookies).
NODE_ENV=production
