<%- include('partials/layout-top', { pageTitle: 'Edit profile' }) %>

<main class="page-main">
  <div class="container-xxl" style="max-width: 780px">
    <section class="glass glass-edge-light rounded-glass p-4 p-md-5 animate-fade-up">
      <span class="eyebrow">Reader profile</span>
      <h1 class="h2 fw-semibold mb-1">Edit profile</h1>
      <p class="text-soft mb-4">Keep your details as neat as a library card.</p>

      <div class="divider-line"></div>

      <form action="/user/updateProfile" method="post">
        <div class="mb-4">
          <label class="form-label" for="inputUsername">Name</label>
          <input
            class="glass-input"
            id="inputUsername"
            name="inputUsername"
            type="text"
            placeholder="Your full name"
            value="<%= typeof user !== 'undefined' && user ? user.fullName : '' %>"
          />
        </div>

        <div class="mb-4">
          <label class="form-label" for="inputEmailAddress">Email</label>
          <input
            class="glass-input"
            id="inputEmailAddress"
            name="inputEmailAddress"
            type="email"
            placeholder="reader@example.com"
            value="<%= typeof user !== 'undefined' && user ? user.email : '' %>"
          />
        </div>

        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-glass btn-glass-primary" type="submit">Save changes</button>
          <a class="btn btn-glass btn-glass-ghost" href="/user/profile">Cancel</a>
        </div>
      </form>
    </section>
  </div>
</main>

<%- include('partials/layout-bottom') %>
