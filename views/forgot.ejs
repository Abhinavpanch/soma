<%- include('partials/layout-top', { pageTitle: 'Forgot password' }) %>

<main class="auth-stage">
  <div class="auth-glass-card glass-shimmer animate-fade-up">
    <a class="auth-brand" href="/">
      <span class="brand-mark"></span>
      <span>Soma</span>
    </a>

    <h1 class="auth-title">Lost your place?</h1>
    <p class="auth-sub">Enter your email and we will help you turn back the page.</p>

    <div class="divider-line"></div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message mb-3"><%= error %></div>
    <% } %>

    <form id="forgotPasswordForm">
      <div class="mb-4">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="glass-input" id="email" name="email" placeholder="reader@example.com" required autofocus />
      </div>
      <button class="btn btn-glass btn-glass-primary w-100" type="submit">Reset password</button>
      <p id="infoMessage" class="info-message text-center mt-3 mb-0"></p>
    </form>

    <div class="divider-line"></div>

    <p class="text-center mb-0 small text-soft">
      Remembered it?
      <a class="auth-link" href="/user/login">Back to sign in</a>
    </p>
  </div>
</main>

<script>
  document.getElementById('forgotPasswordForm').addEventListener('submit', function (e) {
    e.preventDefault();
    document.getElementById('infoMessage').textContent =
      'If that email exists on our shelves, a reset link is on its way.';
  });
</script>

<%- include('partials/layout-bottom') %>
