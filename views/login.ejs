<%- include('partials/layout-top', { pageTitle: 'Sign in' }) %>

<main class="auth-stage">
  <div class="auth-glass-card glass-shimmer animate-fade-up">
    <a class="auth-brand" href="/">
      <span class="brand-mark"></span>
      <span>Soma</span>
    </a>

    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-sub">Open your book and continue reading.</p>

    <div class="divider-line"></div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message mb-3"><%= error %></div>
    <% } %>

    <form action="/user/login" method="POST">
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="glass-input" id="email" name="email" placeholder="reader@example.com" required autofocus />
      </div>
      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="glass-input" id="password" name="password" placeholder="Your secret ink" required />
      </div>
      <button class="btn btn-glass btn-glass-primary w-100" type="submit">Sign in</button>
    </form>

    <div class="divider-line"></div>

    <p class="text-center mb-2 small text-soft">
      New to the shelf?
      <a class="auth-link" href="/user/signup">Create an account</a>
    </p>
    <p class="text-center mb-0">
      <a class="auth-link small" href="/user/forgot">Forgot password?</a>
      <span class="mx-2 text-soft">·</span>
      <a class="auth-link small" href="/">Browse as guest</a>
    </p>
  </div>
</main>

<%- include('partials/layout-bottom') %>
