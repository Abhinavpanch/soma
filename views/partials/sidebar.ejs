<div class="offcanvas offcanvas-start offcanvas-glass" data-bs-scroll="true" tabindex="-1" id="offcanvasWithBothOptions" aria-labelledby="offcanvasWithBothOptionsLabel">
  <div class="offcanvas-header d-flex align-items-center">
    <h5 class="offcanvas-title mb-0" id="offcanvasWithBothOptionsLabel">
      <span class="d-flex align-items-center gap-2">
        <span class="brand-mark d-inline-block" style="width:14px;height:14px;border-radius:4px;background:linear-gradient(135deg,#e5bd5e,#b07f1d);box-shadow:0 0 0 3px rgba(176,127,29,0.18);transform:rotate(8deg)"></span>
        <span class="d-none d-sm-inline">The Soma Shelf</span>
        <span class="d-sm-none">Shelf</span>
      </span>
    </h5>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="offcanvas" aria-label="Close sidebar"></button>
  </div>

  <div class="offcanvas-body d-flex flex-column">
    <!-- Mobile search -->
    <form action="/posts/search" class="d-flex gap-2 d-lg-none mb-3" role="search" method="post">
      <input
        class="form-control form-search"
        type="search"
        id="searchInputMobile"
        name="searchInput"
        placeholder="Search the shelves..."
        aria-label="Search"
      />
      <button class="btn btn-glass btn-glass-primary flex-shrink-0" type="submit" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 109.803 9.803l5.197 5.197m0 0 1.06-1.06" /></svg>
      </button>
    </form>

    <!-- Primary nav -->
    <ul class="nav flex-column gap-1 mb-3 sidebar-reveal">
      <li class="nav-item">
        <a href="/" class="nav-link" aria-current="page">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="me-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" /></svg>
          Home
        </a>
      </li>
      <% if (typeof user !== 'undefined' && user) { %>
        <li class="nav-item">
          <a href="/posts/add" class="nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="me-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" /></svg>
            New post
          </a>
        </li>
        <li class="nav-item">
          <a href="/user/posts" class="nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="me-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            My posts
          </a>
        </li>
        <li class="nav-item">
          <a href="/user/profile" class="nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="me-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Profile
          </a>
        </li>
        <% if (user.isAdmin) { %>
          <li class="nav-item">
            <a href="/admin/dashboard" class="nav-link">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="me-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
              Admin dashboard
            </a>
          </li>
        <% } %>
      <% } %>
      <li class="nav-item">
        <a href="#popular" class="nav-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="me-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>
          Popular
        </a>
      </li>
    </ul>

    <!-- Genres -->
    <div class="px-2">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="genre-label mb-0">Genres</span>
        <button class="btn btn-glass btn-glass-ghost border-0 btn-sm py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#genreList" aria-expanded="true" aria-controls="genreList">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
      </div>
      <div class="collapse show" id="genreList">
        <div class="row g-1">
          <div class="col-6">
            <ul class="nav flex-column" style="font-size:0.85rem">
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Fiction</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Non-Fiction</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Poetry</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Mystery</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Fantasy</a></li>
            </ul>
          </div>
          <div class="col-6">
            <ul class="nav flex-column" style="font-size:0.85rem">
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Biography</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Romance</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Thriller</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Horror</a></li>
              <li class="nav-item"><a href="/" class="genre-item nav-link p-0">Historical</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Spacer + profile / auth -->
    <div class="mt-auto pt-3">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="glass-soft rounded-4 p-3 d-flex align-items-center gap-3">
          <span class="avatar-circle" style="width:40px;height:40px">
            <%= (user.fullName || 'S').charAt(0).toUpperCase() %>
          </span>
          <div class="min-w-0 overflow-hidden flex-grow-1">
            <div class="fw-semibold text-truncate"><%= user.fullName || 'Reader' %></div>
            <div class="text-soft text-truncate" style="font-size:0.8rem"><%= user.email || '' %></div>
          </div>
          <a href="/user/profile" class="auth-link small" aria-label="Profile">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
          </a>
        </div>
        <form action="/user/logout" method="POST" class="d-grid mt-2">
          <button class="btn btn-glass btn-glass-ghost text-danger" type="submit">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-7.5A2.25 2.25 0 003.75 5.25v13.5A2.25 2.25 0 006 21h7.5a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
            Log out
          </button>
        </form>
      <% } else { %>
        <div class="text-center small mb-2">
          <span class="text-soft">New to the shelf?</span>
        </div>
        <div class="d-grid gap-2">
          <a href="/user/signup" class="btn btn-glass btn-glass-primary">Create account</a>
          <a href="/user/login" class="btn btn-glass btn-glass-ghost">Sign in</a>
        </div>
      <% } %>
    </div>
  </div>
</div>
