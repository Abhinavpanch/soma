<%- include('partials/layout-top', { pageTitle: 'My profile' }) %>

<main class="page-main">
  <div class="container-xxl" style="max-width: 900px">
    <% if (typeof user !== 'undefined' && user) { %>
      <section class="glass glass-edge-light rounded-glass p-4 p-md-5 animate-fade-up">
        <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
          <span class="profile-avatar"><%= (user.fullName || 'S').charAt(0).toUpperCase() %></span>
          <div class="text-center text-sm-start flex-grow-1">
            <span class="eyebrow">Reader profile</span>
            <h1 class="h2 fw-semibold mb-1"><%= user.fullName %></h1>
            <p class="text-soft mb-2"><%= user.email %></p>
            <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-sm-start">
              <% if (user.isAdmin) { %>
                <span class="chip">Admin</span>
              <% } %>
              <% if (typeof user.createdAt !== 'undefined') { %>
                <span class="chip">
                  Member since <%= new Date(user.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                </span>
              <% } %>
            </div>
          </div>
          <div class="d-flex flex-column gap-2 flex-shrink-0">
            <a class="btn btn-glass btn-glass-primary" href="/user/editProfile">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" /></svg>
              Edit profile
            </a>
            <a class="btn btn-glass btn-glass-ghost" href="/user/posts">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              My posts
            </a>
          </div>
        </div>
      </section>
    <% } else { %>
      <div class="empty-state reveal">
        <h3 class="h4 mb-1">Not signed in</h3>
        <p class="mb-3">Sign in to view your profile.</p>
        <a class="btn btn-glass btn-glass-primary" href="/user/login">Sign in</a>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/layout-bottom') %>
