<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search</title>
</head>
<body>
  <%- include('partials/head') %> <%- include('partials/navbar') %> <%-
  include('partials/sidebar') %>

  <div class="post-container d-block container col-7 mt-5">
    <% if (results.length === 0) { %>
    <p>No posts available yet.</p>
      <% } else { %> <% results.forEach(post => { %>
      <div class="post mb-4 p-3 border-bottom heading-container">
      <a href="/posts/<%= post.id %>" class="text-dark" style="text-decoration: none">
        <div class=" border-bottom row mb-4 pt-4">
        <h4><%= post.title %></h4>
        <p class="genre fs-6 lead container col text-muted">
          Genre: <%= post.genre %>
        </p>
        <p class="author fs-6 lead col small text-muted">
          Author: <%= post.author ? post.author : "Unknown" %>
        </p>
        </div>
        <p><%= post.content %></p>
      </a>
      </div>
      <% }); %> <% } %>
  </div>
</body>
</html>