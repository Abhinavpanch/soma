<%- include('partials/layout-top', { pageTitle: 'Create account' }) %>

<main class="auth-stage">
  <div class="auth-glass-card glass-shimmer animate-fade-up">
    <a class="auth-brand" href="/">
      <span class="brand-mark"></span>
      <span>Soma</span>
    </a>

    <h1 class="auth-title">Start your shelf</h1>
    <p class="auth-sub">Every story begins with a first page.</p>

    <div class="divider-line"></div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message mb-3"><%= error %></div>
    <% } %>

    <form action="/user/signup" method="POST">
      <div class="mb-3">
        <label for="fullName" class="form-label">Full name</label>
        <input type="text" class="glass-input" id="fullName" name="fullName" placeholder="Jane Austen" required autofocus />
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="glass-input" id="email" name="email" placeholder="reader@example.com" required />
      </div>
      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="glass-input" id="password" name="password" placeholder="Choose a strong one" required />
      </div>
      <button class="btn btn-glass btn-glass-primary w-100" type="submit">Create account</button>
    </form>

    <div class="divider-line"></div>

    <p class="text-center mb-0 small text-soft">
      Already a reader?
      <a class="auth-link" href="/user/login">Sign in</a>
    </p>
  </div>
</main>

<%- include('partials/layout-bottom') %>
